# Copy to .env.qa and fill in. Never commit .env.qa (it's gitignored).
# Real addresses you control — five distinct Gmail +alias addresses off one
# inbox work fine, per QA_TEST_PLAN.md §2.1's own recommendation.

QA_EMAIL_ADMIN_A=you+qa-admin-a@gmail.com
QA_EMAIL_USER_A=you+qa-user-a@gmail.com
QA_EMAIL_ADMIN_B=you+qa-admin-b@gmail.com
QA_EMAIL_PLATFORM=you+qa-platform@gmail.com
QA_EMAIL_NOORG=you+qa-noorg@gmail.com

# One password used for all seeded accounts — test-only, never real.
QA_PASSWORD=Qa-Test-Password-1

# Base URL the suite runs against. Local dev by default; see
# PLAYWRIGHT_QA_PLAN.md §9 before ever pointing this at production.
QA_BASE_URL=http://localhost:3000
