{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "SUPABASE_SERVICE_ROLE_KEY",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "INTASEND_SECRET_KEY",
    "INTASEND_WEBHOOK_CHALLENGE",
    "INTASEND_SANDBOX",
    "SYNTRA_INTAKE_ORG_ID",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "N8N_BASE_URL",
    "N8N_API_KEY",
    "N8N_WEBHOOK_SECRET",
    "N8N_ORG_ID",
    "CRON_SECRET",
    "CREDENTIAL_ENCRYPTION_KEY",
    "AI_PROVIDER",
    "ANTHROPIC_API_KEY",
    "OPENROUTER_API_KEY",
    "OPENROUTER_MODEL",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_STRIPE_PRICE_SITES",
        "NEXT_PUBLIC_STRIPE_PRICE_FLOW",
        "NEXT_PUBLIC_STRIPE_PRICE_OS",
        "NEXT_PUBLIC_STRIPE_PRICE_MARKETING",
        "NEXT_PUBLIC_INTASEND_PUBLIC_KEY",
        "NEXT_PUBLIC_INTASEND_PRICE_SITES_KES",
        "NEXT_PUBLIC_INTASEND_PRICE_FLOW_KES",
        "NEXT_PUBLIC_INTASEND_PRICE_OS_KES",
        "NEXT_PUBLIC_INTASEND_PRICE_MARKETING_KES",
        "NEXT_PUBLIC_SENTRY_DSN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
