# AI Gateway — see AI_PROVIDER_ABSTRACTION_PLAN.md
# AI_PROVIDER unset or "anthropic" (default) = production. "openrouter" = build/test.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Only needed when AI_PROVIDER=openrouter. Never put an OpenRouter key in
# ANTHROPIC_API_KEY above — that mix-up is exactly what this variable exists to prevent.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=

# n8n
N8N_WEBHOOK_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Security
CRON_SECRET=
AI_SERVICE_SECRET=

# Rate limiting — free database at upstash.com (Redis, REST API).
# Unset: rate limiting no-ops (logs a warning) rather than blocking all traffic.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
